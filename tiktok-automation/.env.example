# Copy to .env and fill in. Never commit the real .env file.

# --- General ---
TIMEZONE=Asia/Dubai

# --- n8n ---
N8N_HOST=your-domain-or-ip
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://your-domain-or-ip:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# --- Postiz (scheduling + TikTok posting) ---
POSTIZ_MAIN_URL=http://your-domain-or-ip:5000
POSTIZ_JWT_SECRET=generate-a-long-random-string
POSTGRES_PASSWORD=change-me
# From TikTok Developer Portal once your Postiz-registered app is approved
# (Postiz docs walk through this per their self-hosted setup guide)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# --- LLM (script writing + topic research) ---
LLM_PROVIDER=anthropic   # or openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Voiceover ---
ELEVENLABS_API_KEY=

# --- Stock footage (free tier) ---
PEXELS_API_KEY=

# --- Human approval gate ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
